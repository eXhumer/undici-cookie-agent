{
  "name": "@exhumer/undici-cookie-agent",
  "version": "2.0.0",
  "description": "Cookie jar support for undici (v7, v8)",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "eXhumer",
    "email": "github@exhumer.cc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eXhumer/undici-cookie-agent"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0"
    },
    "packageManager": {
      "name": "npm"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.types.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "coverage": "vitest run --coverage --reporter=junit --outputFile=test-report.junit.xml"
  },
  "peerDependencies": {
    "tough-cookie": ">=6.0.0",
    "undici": ">=7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-istanbul": "^4.1.9",
    "tough-cookie": "^6.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "undici": "^8.5.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
